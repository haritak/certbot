<%= form_with(model: csv_file) do |form| %>
  <% if csv_file.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(csv_file.errors.count, "error") %> prohibited this csv_file from being saved:</h2>

      <ul>
        <% csv_file.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :filename, style: "display: block" %>
    <%= form.text  :filename %>
  </div>

  <div>
    <%= form.label :file, style: "display: block" %>
    <%= form.file_field :file, 
      accept: "text/csv",
      required: true
    %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
