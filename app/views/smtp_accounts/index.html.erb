<h1>οι SMTP λογαριασμοί μου</h1>


<div id="smtp_accounts">
  <table>
    <tr>
      <th>
      </th>
      <th>Περιγραφή</th>
      <th>αποστολέας</th>
      <th>Εξυπηρετητής</th>
      <th>Όνομα χρήστη</th>
      <th></th>
    </tr>
    <% @smtp_accounts.each do |smtp_account| %>
      <%= render smtp_account %>
      <td><%= link_to "προβολή/δοκιμή", smtp_account %></td>
    <% end %>
  </table>
</div>

<p>
<%= link_to "Προσθήκη νέου", new_smtp_account_path %>
</p>
