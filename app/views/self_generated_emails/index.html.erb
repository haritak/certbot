<%= stylesheet_link_tag "self_generated_emails.css" %>

<h1><%= @self_service_print_job_spec %> : δημιουργηθέντα emails από χρήστες</h1>
<% if @failed_self_generated_emails.count > 0 %>
  <h2>με σφάλματα</h2>
  <table>
    <tr>
      <th>email_id</th><th>recipient</th><th>created_at</th><th>sent_at</th>
      <th>status</th><th>attachment</th><th></th><th></th>
    </tr>
    <% @failed_self_generated_emails.each do |self_generated_email| %>
      <tr class="self_generated_email_row" id="<%= dom_id self_generated_email %>" >
        <td><%= self_generated_email.id %> </td>
        <td><%= self_generated_email.recipient %> </td>
        <td><%= self_generated_email.created_at %> </td>
        <td><%= self_generated_email.updated_at %> </td>
        <td>
          <% if self_generated_email.status == "SENT" %>
            <span style="color: green">
              <%= self_generated_email.status %>
            </span>
          <% else %>
            <span style="color: red">
              <u><%= self_generated_email.status %></u>
            </span>
          <%end%>
        </td>
        <td>
          <% url_to_attachment = self_generated_email.attachment_path.gsub( Rails.root.to_s, "" )%>
          <%= link_to( "attachment", url_for( url_to_attachment ) )%>
        </td>
        <td>
          delete
        </td>
        <td>
          <%= link_to( "resend", resend_self_generated_email_path( self_generated_email  ) ) %>
        </td>
      </tr>
    <% end %>
  </table>
  <%= link_to "επαναποστολή όλων #{@failed_self_generated_emails.count}", resend_emails_self_service_print_job_spec_path %>
  <hr/>
<%end%>
<div id="self_service_generated_files">
  <%== pagy_nav(@pagynated_emails) %>
  <table>
    <tr>
      <th>email_id</th><th>recipient</th><th>created_at</th><th>sent_at</th>
      <th>status</th><th>attachment</th><th></th><th></th>
    </tr>
    <% @self_generated_emails.each do |self_generated_email| %>
      <tr class="self_generated_email_row" id="<%= dom_id self_generated_email %>" >

        <td><%= self_generated_email.id %> </td>
        <td><%= self_generated_email.recipient %> </td>
        <td><%= self_generated_email.created_at %> </td>
        <td><%= self_generated_email.updated_at %> </td>

        <td>
          <% if self_generated_email.status == "SENT" %>
            <span style="color: green">
              <%= self_generated_email.status %>
            </span>
          <% else %>
            <span style="color: red">
              <u><%= self_generated_email.status %></u>
            </span>
          <%end%>
        </td>

        <td>
          <% url_to_attachment = self_generated_email.attachment_path.gsub( Rails.root.to_s, "" )%>
          <%= link_to( "attachment", url_for( url_to_attachment ) )%>
        </td>
        <td>
          delete
        </td>
        <td>
          <%= link_to( "resend", resend_self_generated_email_path( self_generated_email  ) ) %>
        </td>
      </tr>
    <% end %>
  </table>
  <%== pagy_nav(@pagynated_emails) %>
</div>

