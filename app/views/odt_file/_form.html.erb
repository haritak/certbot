<%= form_with(model: odt_file) do |form| %>
  <% if odt_file.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(odt_file.errors.count, "error") %> prohibited this odt_file from being saved:</h2>

      <ul>
        <% odt_file.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :filename, style: "display: block" %>
    <%= form.text :filename %>
  </div>

  <div>
    <%= form.label :file, style: "display: block" %>
    <%= form.file_field :file, 
      accept: "application/vnd.oasis.opendocument.text",
      required: true
    %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
