<div id="<%= dom_id print_job_spec %>">
  <p>
    <strong>User:</strong>
    <%= print_job_spec.user_id %>
  </p>

  <p>
    <strong>Odt file:</strong>
    <%= print_job_spec.odt_file_id %>
  </p>

  <p>
    <strong>Csv file:</strong>
    <%= print_job_spec.csv_file_id %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= print_job_spec.status %>
  </p>

  <p>
    <strong>Messages:</strong>
    <%= print_job_spec.messages %>
  </p>

  <p>
    <strong>Comment:</strong>
    <%= print_job_spec.comment %>
  </p>

</div>
