<%= form_with(model: email_job) do |form| %>
  <% if email_job.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(email_job.errors.count, "error") %> prohibited this email_job from being saved:</h2>

      <ul>
        <% email_job.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
