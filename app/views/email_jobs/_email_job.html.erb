<div id="<%= dom_id email_job %>">
  <p>
    <strong>Email job spec:</strong>
    <%= email_job.email_job_spec_id %>
  </p>

  <p>
    <strong>Execution job:</strong>
    <%= email_job.execution_job_id %>
  </p>

  <p>
    <strong>Csv entry:</strong>
    <%= email_job.csv_entry %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= email_job.status %>
  </p>

  <p>
    <strong>Retries left:</strong>
    <%= email_job.retries_left %>
  </p>

</div>
