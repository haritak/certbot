 <h1> Διαθέσιμα σταθερά αρχείο (fixed attachments) </h1>
<table>
  <% @fixed_attachments.each do |fixed_attachment| %>
    <%= render fixed_attachment %>
  <% end %>
</table>

<p/>

<% if @fixed_attachments.count == 0 %>
  <p>Δεν υπάρχουν</p>
<% end %>

<div>
  <%= turbo_frame_tag "new_fixed_attachment", target: "_top" do %>
    <%= link_to "Ανέβασμα νέου σταθερού συνημμένου", new_fixed_attachment_path, data: { turbo_frame: "new_fixed_attachment" } %>
  <% end %>
</div>
