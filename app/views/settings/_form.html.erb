<%= form_with(model: user) do |form| %>
  <% if @user.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(@user.errors.count, "error") %> prohibited these settings from being saved:</h2>
      <ul>
        <% @user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <h2> 
    Λογαριασμός για την αποστολή μηνυμάτων 
    <%= user != current_user ? "του #{user.email}" : "" %>
  </h2>

  <%= form.hidden_field :id, value: user.id %>

  <table>
    <tr>
      <td> <%= form.label :smtp_account_id %> </td>
      <td> 
        <%= form.collection_select( :smtp_account_id,
                              SystemSmtpAccount.all.or(user.smtp_accounts), 
                              :id, :long_description, prompt: true) %>
      </td>
    </tr>
    <% if current_user.admin? %>
      <tr>
        <td> Ενεργοποίηση χρήστη (<%= form.label :activated %>) </td>
        <td>
          <%= form.check_box :activated %> 
        </td>
      </tr>
    <% end %>
  </table>

  <div>
    <%= form.submit "Ενημέρωση στοιχείων" %>
  </div>

<% end %>
